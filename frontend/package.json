{
  "name": "folope",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "set-env": "ts-node set-env.ts",
    "start": "npm run set-env && ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "serve:ssr:folope": "node dist/folope/server/server.mjs"
  },
  "prettier": {
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "^20.1.0",
    "@angular/common": "^20.3.3",
    "@angular/compiler": "^20.3.3",
    "@angular/core": "^20.3.3",
    "@angular/forms": "^20.3.3",
    "@angular/platform-browser": "^20.3.3",
    "@angular/platform-server": "^20.3.3",
    "@angular/router": "^20.3.3",
    "@angular/ssr": "^20.3.3",
    "@tailwindcss/postcss": "^4.1.11",
    "daisyui": "^5.0.50",
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "lucide-angular": "^0.536.0",
    "postcss": "^8.5.6",
    "rxjs": "~7.8.0",
    "tailwindcss": "^4.1.11",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^20.3.3",
    "@angular/cli": "^20.3.3",
    "@angular/compiler-cli": "^20.3.3",
    "@types/express": "^5.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.17.19",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "jest-preset-angular": "^15.0.2",
    "jsdom": "^27.0.0",
    "postcss": "^8.5.3",
    "ts-node": "^10.9.2",
    "typescript": "~5.8.2"
  }
}
